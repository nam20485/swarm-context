# Repo-local suppression for scan-uncommitted-secrets.
# Test files that contain synthetic token-shaped fixtures by design.
path:.agents/skills/gh-issue-tracking-init/scripts/tests/*.ps1
# opencode.jsonc / .zcode example: env-var indirection and angle-bracket
# placeholders — no literal credential values (opencode substitutes
# {env:VAR} at runtime; the example file shows the placeholder literal).
line:"x-api-key": "\{env:EXA_API_KEY\}"
line:"apiKey": "\{env:[A-Z_0-9]+\}"
line:"x-api-key": "<EXA_API_KEY>"
